{
  "on_http_request": [
    {
      "expressions": [
        "!(conn.client_ip.as.organization.contains('Facebook'))"
      ],
      "actions": [
        {
          "type": "custom-response",
          "config": {
            "status_code": 403,
            "body": "Hostname not allowed"
          }
        }
      ]
    }
  ]
}